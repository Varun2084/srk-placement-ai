{
  // VS Code: Terminal > Run Task...  (pehli baar "1. Setup (first time)", phir "2. Run app")
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup: backend (Python venv + packages)",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/pip install -r backend/requirements-dev.txt",
      "windows": { "command": "python -m venv .venv; .venv\\Scripts\\pip install -r backend\\requirements-dev.txt" },
      "problemMatcher": []
    },
    {
      "label": "Setup: frontend (npm install)",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Seed demo data (resets local database)",
      "type": "shell",
      "command": "../.venv/bin/python seed.py --reset",
      "windows": { "command": "..\\.venv\\Scripts\\python seed.py --reset" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "1. Setup (first time)",
      "dependsOrder": "sequence",
      "dependsOn": ["Setup: backend (Python venv + packages)", "Setup: frontend (npm install)", "Seed demo data (resets local database)"],
      "problemMatcher": []
    },
    {
      "label": "Run backend (API on :8000)",
      "type": "shell",
      "command": "../.venv/bin/python -m uvicorn app.main:app --reload --port 8000",
      "windows": { "command": "..\\.venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000" },
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": { "JWT_SECRET": "local-dev-only-secret-do-not-use-in-production-0001" }
      },
      "isBackground": true,
      "problemMatcher": { "pattern": { "regexp": "^x^" }, "background": { "activesBegin": "Will watch|Started reloader", "beginsPattern": "Will watch|Started reloader", "endsPattern": "Application startup complete" } },
      "presentation": { "group": "app", "panel": "dedicated" }
    },
    {
      "label": "Run frontend (web on :5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": { "pattern": { "regexp": "^x^" }, "background": { "activesBegin": "VITE", "beginsPattern": "VITE", "endsPattern": "Local:" } },
      "presentation": { "group": "app", "panel": "dedicated" }
    },
    {
      "label": "2. Run app (backend + frontend)",
      "dependsOn": ["Run backend (API on :8000)", "Run frontend (web on :5173)"],
      "problemMatcher": []
    },
    {
      "label": "Test: backend (pytest)",
      "type": "shell",
      "command": "../.venv/bin/python -m pytest -q",
      "windows": { "command": "..\\.venv\\Scripts\\python -m pytest -q" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
