# Copy to .env and change every value before real use.
JWT_SECRET=replace-with-64-random-hex-characters
POSTGRES_PASSWORD=change-me
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
# 1 = load synthetic demo data on first start (never with real students)
SEED_DEMO=1
CONSENT_VERSION=2026-11-v1
# none = fully local (default). Optional upgrades:
LLM_PROVIDER=none
EMBEDDING_PROVIDER=tfidf   # or sbert (pip install sentence-transformers)
