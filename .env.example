# Copy to .env and change every value before real use.
JWT_SECRET=replace-with-64-random-hex-characters
POSTGRES_PASSWORD=change-me
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
# 1 = load synthetic demo data on first start (never with real students)
SEED_DEMO=1
# Used only when SEED_DEMO=0: the first admin account
ADMIN_EMAIL=admin@srk.local
ADMIN_PASSWORD=
# Port on the server (80 = open with just the IP address)
APP_PORT=80
# Optional public HTTPS via Cloudflare Tunnel (see docs/COLLEGE_SERVER_SETUP.md)
CLOUDFLARE_TUNNEL_TOKEN=
CONSENT_VERSION=2026-11-v1
# none = fully local (default). Optional upgrades:
LLM_PROVIDER=none
# EMBEDDING_PROVIDER: tfidf (default) or sbert (needs sentence-transformers)
EMBEDDING_PROVIDER=tfidf
